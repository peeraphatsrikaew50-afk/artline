*.ppt
*.pptx
*.pptm
*.pot
*.potx

# PDF
*.pdf

# Text & Note Files ที่อาจมีข้อมูลสำคัญ
*.txt
*.rtf
*.odt
*.ods
*.odp


# ===== 🟠 ไฟล์บันทึก / Log Files =====

*.log
*.log.*
logs/
