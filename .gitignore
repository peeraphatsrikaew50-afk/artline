# ============================================================
# .gitignore — Online Artwork Project
# ป้องกันไฟล์ที่มีความเสี่ยงต่อการรั่วไหลและไฟล์ที่ไม่จำเป็น
# ============================================================


# ===== 🔴 ความเสี่ยงสูง — ไฟล์ข้อมูลสำคัญ / Credentials =====

# Environment Variables (API Keys, Secrets, Passwords)
.env
.env.local
.env.development
.env.staging
.env.production
.env.backup
*.env

# Configuration ที่มี Secret Keys
config.secret.js
config.prod.js
secrets.js
credentials.js
keys.js

# ===== 🔴 Google Apps Script (GAS) Source Files =====
# ป้องกัน Logic ของ Backend และ Service Account ไม่ให้รั่วไหล
gas/
*.gs
appsscript.json


# ===== 🟠 เอกสาร Office ที่อาจมีข้อมูลส่วนตัว =====

